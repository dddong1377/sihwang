name: 시황 자동 실행

on:
  schedule:
    # 한국시간 월~금 07:00~08:59 (UTC 일~목 22~23시) 10분마다
    - cron: "*/10 22-23 * * 0-4"
    # 한국시간 월~금 09:00~16:59 (UTC 월~금 00~07시) 10분마다
    - cron: "*/10 0-7 * * 1-5"
  workflow_dispatch: {}

concurrency:
  group: auto-siwhang
  cancel-in-progress: false

jobs:
  check:
    runs-on: ubuntu-latest
    timeout-minutes: 5
    outputs:
      due: ${{ steps.check.outputs.due }}
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: "3.12"
      - run: pip install requests holidays
      - id: check
        run: python scripts/auto_trigger.py check
        env:
          GIST_TOKEN: ${{ secrets.GIST_TOKEN }}
          GIST_ID: ${{ secrets.GIST_ID }}

  run:
    needs: check
    if: needs.check.outputs.due != ''
    runs-on: ubuntu-latest
    timeout-minutes: 45
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: "3.12"
      - run: |
          pip install requests playwright
          playwright install --with-deps chromium
      - name: 실행할 시황글 만들기
        run: |
          for kind in ${{ needs.check.outputs.due }}; do
            python scripts/auto_trigger.py run "$kind" || true
          done
        env:
          GIST_TOKEN: ${{ secrets.GIST_TOKEN }}
          GIST_ID: ${{ secrets.GIST_ID }}
          APP_URL: ${{ secrets.APP_URL }}
          APP_PASSWORD: ${{ secrets.APP_PASSWORD || secrets.app_password }}
